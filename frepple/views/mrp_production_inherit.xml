<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_frepple" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.frepple</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="xx_keep_confirmed" />
            </field>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_frepple" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.frepple</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <tree position="inside">
                <field name="xx_keep_confirmed" optional="hide" />
            </tree>
        </field>
    </record>
</odoo>
